{
  "name": "@krystiangw/zen-mcp",
  "mcpName": "io.github.krystiangw/zen",
  "version": "0.1.0",
  "description": "Unofficial MCP server for the ZEN.com Payment Gateway (payment links, transactions, refunds, payouts, reporting).",
  "type": "module",
  "bin": { "zen-mcp": "dist/index.js" },
  "main": "dist/index.js",
  "files": ["dist", "README.md", "LICENSE"],
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "model-context-protocol", "modelcontextprotocol", "claude", "llm", "ai", "fintech", "payments", "zen", "zen.com", "payment-gateway"],
  "license": "MIT",
  "author": "Krystian Gwizdała",
  "repository": { "type": "git", "url": "git+https://github.com/krystiangw/zen-mcp.git" },
  "homepage": "https://github.com/krystiangw/zen-mcp#readme",
  "bugs": { "url": "https://github.com/krystiangw/zen-mcp/issues" },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
